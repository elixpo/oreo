# Copy to .env.local (git-ignored) and fill in only what you need.
# tools/deploy.py reads it through oreoOS/config.py and writes the values
# into /secrets.py on the badge. Anything left blank stays off.
#
# You can also skip this file entirely and set your profile on the badge
# in /profile.json (see docs/PROFILE.md); the badge prefers that file.

# ── Your profile (Badge, Identity, Commits, clock) ──
GITHUB_USER=
DISPLAY_NAME=
DESIGNATION=
# Hours from UTC, e.g. 5.5 for India, -4 for New York in summer.
TIMEZONE_OFFSET=

# ── Weather app (App Store) ──
WEATHER_LAT=
WEATHER_LON=
WEATHER_NAME=
OWM_API_KEY=

# ── Wi-Fi, for the internet only (App Store, updates, GitHub, weather, time) ──
# Comma-separated, in priority order. The two lists line up by position.
# The oreo CLI can also add networks over USB without redeploying.
WIFI_SSID=
WIFI_PASSWORD=

# ── Optional: raises the GitHub API rate limit for the App Store and updates ──
GH_TOKEN=
